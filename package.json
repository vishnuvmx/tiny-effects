{
  "name": "tiny-effects",
  "version": "1.0.0",
  "private": true,
  "description": "Dedicated Plugin for Little Image Effects inside Figma",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:ui": "vite build",
    "build:controller": "esbuild src/controller/main.ts --bundle --outfile=dist/controller.js --target=es2017 --format=iife",
    "build": "tsc --noEmit && npm run build:ui && npm run build:controller",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "check": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.105.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "@vitejs/plugin-react": "^4.3.3",
    "vite-plugin-singlefile": "^2.0.2"
  }
}
